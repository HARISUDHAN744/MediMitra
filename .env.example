# Gemini API Credentials from Google AI Studio
GEMINI_API_KEY=your_key_here

# Exact model name from Gemini docs (e.g. gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key for Whisper Speech-to-Text and GPT-4o fallback
OPENAI_API_KEY=your_openai_api_key_here

# Gnani.ai Vachana Voice & Speech Engine API Key
GNANI_API_KEY=vach_your_key_here
